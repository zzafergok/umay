# Umay Environment Variables Example

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication & Security
# WARNING: Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=umay-secret-key-change-in-production
ALLOW_DEMO_AUTH=true

# Firebase Configuration (Web App & Project)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Production Server Credentials - Optional for local emulator)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatively, pass full JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Cron / Job Secret (for /api/jobs/refresh-parts)
CRON_SECRET=umay-cron-secret-change-in-production

# OpenRouter AI Provider (Receipt Vision & Text Analysis)
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional overrides:
# OPENROUTER_DEFAULT_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_APP_NAME=Umay
# OPENROUTER_SITE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
