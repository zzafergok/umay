# Umay Environment Variables Example

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication & Security
# WARNING: Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=umay-secret-key-change-in-production
ALLOW_DEMO_AUTH=true

# Firebase Configuration (Web App & Project)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Cron / Job Secret (for /api/jobs/refresh-parts)
CRON_SECRET=umay-cron-secret-change-in-production

# Node Environment
NODE_ENV=development
