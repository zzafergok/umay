# Umay Environment Variables Example

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication & Security
# WARNING: Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=umay-secret-key-change-in-production
ALLOW_DEMO_AUTH=true

# Firebase Client SDK (for Google Sign-In & Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=umay-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=umay-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Firebase Admin SDK (Server-side Firestore & Storage)
FIREBASE_PROJECT_ID=umay-local
FIREBASE_STORAGE_BUCKET=umay-local.appspot.com
# Production Service Account (leave empty when using Emulator locally):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_WEB_API_KEY=

# Local Firebase Emulator Suite (comment out when connecting to live Firebase project)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cron / Job Secret (for /api/jobs/refresh-parts)
CRON_SECRET=umay-cron-secret-change-in-production

# Node Environment
NODE_ENV=development
